{
  "name": "light",
  "description": "Lightweight agent - no hooks, no restrictions",
  "tools": ["@builtin"],
  "allowedTools": ["fs_read", "fs_write", "execute_bash", "use_aws", "code", "web_search", "web_fetch", "grep", "glob"],
  "hooks": {
    "userPromptSubmit": [
      {
        "command": "/home/pierrot/dotfiles-pierrot/kiro-conf/kiro-start-timer.sh"
      }
    ],
    "stop": [
      {
        "command": "/home/pierrot/dotfiles-pierrot/kiro-conf/kiro-notify-if-long.sh"
      }
    ]
  }
}
