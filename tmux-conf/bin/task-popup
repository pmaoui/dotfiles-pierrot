#!/usr/bin/env bash
# usage: task-popup <target pane id>
pane=${1:?pane id required}
here=$(dirname "$(readlink -f "$0")")

if ! err=$("$here/task" count 2>&1 >/dev/null); then
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$root" ]; then
    printf 'No TASKS.md in %s\nCreate an empty one? [y/N] ' "$root"
    read -rsn1 answer
    if [ "$answer" = y ]; then
      : > "$root/TASKS.md"
      printf '\n\nCreated. Ask the agent to fill it.\n\nPress any key to close.'
      read -rsn1
    fi
  else
    printf '%s\n\nPress any key to close.' "$err"
    read -rsn1
  fi
  exit 0
fi

IFS=$'\t' read -r key id < <("$here/task" pick) || exit 0

text=""
if [ -n "$id" ]; then
  if [ "$key" = ctrl-e ]; then
    text=$("$here/task" describe "$id")
  else
    text=$("$here/task" prompt "$id")
  fi
fi

if [ -n "$text" ]; then
  if [ "$key" = tab ]; then
    text+=$'\n'
  fi
  printf '%s' "$text" | tmux load-buffer -b task-popup -
  tmux paste-buffer -p -d -b task-popup -t "$pane"
  if [ "$key" != tab ]; then
    sleep 0.3
    tmux send-keys -t "$pane" Enter
  fi
fi
