#!/usr/bin/env bash
# usage: task list [-a] | count | show <id> | prompt <id> | pick
set -euo pipefail

file="${TASKS_FILE:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/TASKS.md}"
[ -f "$file" ] || { echo "task: no TASKS.md at $file" >&2; exit 1; }

parse() {
  awk -v cmd="$1" -v want="${2:-}" -v now="$(date +%Y-%m-%dT%H:%M)" '
    /^- \[[ x]\] / {
      c++
      state[c] = substr($0, 4, 1)
      n = split(substr($0, 7), p, / \| /)
      id[c] = p[1]; after[c] = ""; text[c] = ""
      for (i = 2; i <= n; i++) {
        if (p[i] ~ /^after:/) after[c] = substr(p[i], 7)
        else text[c] = (text[c] == "" ? p[i] : text[c] " | " p[i])
      }
      innote = 1
      next
    }
    /^[[:space:]]*$/ { innote = 0; next }
    innote { sub(/^  /, ""); note[c] = (note[c] == "" ? $0 : note[c] "\n" $0) }
    function due(i) { return state[i] == " " && (after[i] == "" || after[i] <= now) }
    END {
      for (i = 1; i <= c; i++) {
        if (state[i] == "x") dn++
        if (cmd == "list" && due(i)) print id[i] "\t" text[i]
        else if (cmd == "all") print id[i] "\t[" state[i] "]\t" after[i] "\t" text[i]
        else if (cmd == "count" && due(i)) k++
        else if (cmd == "show" && id[i] == want) {
          print text[i]; if (note[i] != "") print note[i]
          found = 1
        } else if (cmd == "prompt" && id[i] == want) {
          print "Please do this (task " id[i] " in TASKS.md): \"" text[i] "\""
          if (note[i] != "") print note[i]
          found = 1
        }
      }
      if (cmd == "count") print k + 0
      if (cmd == "stats") print dn + 0, c + 0
      if ((cmd == "show" || cmd == "prompt") && !found) exit 1
    }' "$file"
}

pick() {
  local out key sel self
  self=$(readlink -f "$0")
  out=$(parse list | fzf --delimiter=$'\t' --expect=tab --no-multi --reverse \
    --prompt='task> ' --header='Enter: send   Tab: edit   Esc: cancel' \
    --preview "$self show {1}" --preview-window=down,40%,wrap || true)
  key=$(printf '%s\n' "$out" | sed -n 1p)
  sel=$(printf '%s\n' "$out" | sed -n 2p | cut -f1)
  [ -n "$key" ] || [ -n "$sel" ] || exit 1
  printf '%s\t%s\n' "${key:-enter}" "$sel"
}

case "${1:-}" in
  list)   if [ "${2:-}" = "-a" ]; then parse all; else parse list; fi ;;
  count)  parse count ;;
  stats)  parse stats ;;
  show)   parse show "${2:?id required}" ;;
  prompt) parse prompt "${2:?id required}" ;;
  pick)   pick ;;
  *)      echo "usage: task list [-a] | count | stats | show <id> | prompt <id> | pick" >&2; exit 2 ;;
esac
